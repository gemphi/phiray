// The frame's parameters (`kernel.rs`'s `Camera`, kept in step field for
// field), shared by every kernel and the raster prepass.
struct Camera {
    n: u32, groups_x: u32, w: u32, h: u32,
    right: vec3<f32>, persp: u32,
    up: vec3<f32>, scale: f32,
    back: vec3<f32>, units: f32,
    pivot: vec3<f32>, aspect: f32,
    sun: vec3<f32>, dist: f32,
    sky: vec4<f32>,
    pan: vec2<f32>, ao: f32, eps: f32,
    frame: u32, grid: f32, count: u32, glow: u32,
    grid_color: vec4<f32>,
    env: vec4<f32>,
    split: vec4<u32>,
    view: vec4<f32>,
    envmap: u32, env_rot: f32, bounces: u32, env_cdf: u32,
    aperture: f32, focus: f32, blades: u32, blade_spin: f32,
    aperture_ratio: f32, env_hidden: u32, see_through: f32, grid_hide: u32,
    tile: vec4<u32>,
    film: vec4<u32>,
    preview: vec4<u32>,
    slice: vec4<u32>,
    insts: vec4<u32>,
    vis: vec4<u32>,
    taa: vec4<f32>,
    fx: vec4<f32>,
    outline: vec4<f32>,
    shade: vec4<u32>,
    single: vec4<f32>,
    cavity: vec4<f32>,
    ssao: vec4<u32>,
    shadow: vec4<f32>,
    shadow_fade: vec4<f32>,
    matcap: vec4<u32>,
    dof: vec4<f32>,
    lights: array<Light, 16>,
}
struct Light { pos: vec3<f32>, kind: u32, color: vec3<f32>, size: f32, dir: vec3<f32>, cone: f32, right: vec3<f32>, size_y: f32, shape: u32, blend: f32, pad1: u32, pad2: u32 }
